<ui:FluentWindow x:Class="GofileUploader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="GoFile Uploader"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="GoFile Uploader" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="CloudArrowUp24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="22,8,22,22">

            <!-- Drop zone -->
            <Border x:Name="DropZone"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Height="146"
                    AllowDrop="True"
                    Drop="DropZone_Drop"
                    DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave"
                    MouseEnter="DropZone_MouseEnter"
                    MouseLeave="DropZone_MouseLeave"
                    MouseLeftButtonUp="DropZone_Click"
                    Cursor="Hand">
                <Border.Background>
                    <SolidColorBrush x:Name="DropZoneFill" Color="#14FFFFFF"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="DropZoneStroke" Color="#28FFFFFF"/>
                </Border.BorderBrush>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon x:Name="DropIcon" Symbol="ArrowUpload24" FontSize="32"
                                   HorizontalAlignment="Center">
                        <ui:SymbolIcon.Foreground>
                            <SolidColorBrush x:Name="DropIconBrush" Color="#ABABB2"/>
                        </ui:SymbolIcon.Foreground>
                    </ui:SymbolIcon>
                    <TextBlock x:Name="DropTitleText" Text="Drag &amp; drop a file here"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,4"/>
                    <TextBlock x:Name="DropSubText" Text="or click to browse"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12.5"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="FileInfoText" Text="No file selected"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12.5" Margin="4,8,0,0"/>

            <!-- Options card -->
            <ui:CardExpander Icon="{ui:SymbolIcon Settings24}" Header="Options" Margin="0,14,0,0" IsExpanded="True">
                <StackPanel Margin="0,4,0,4">

                    <TextBlock Text="API TOKEN" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:PasswordBox x:Name="TokenBox" Grid.Column="0"
                                        PlaceholderText="Optional - your gofile account token"
                                        Password=""
                                        PasswordChanged="TokenBox_PasswordChanged"/>
                        <ui:Button x:Name="RotateTokenButton" Grid.Column="1" Margin="8,0,0,0"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Style="{StaticResource MotionButtonStyle}"
                                   ToolTip="Clear the token - your next anonymous upload gets a fresh guest account"
                                   Click="RotateTokenButton_Click"/>
                    </Grid>
                    <ui:Button x:Name="LoginButton" Margin="0,8,0,0"
                               Content="Log in with Browser"
                               Icon="{ui:SymbolIcon PersonCircle24}"
                               Style="{StaticResource MotionButtonStyle}"
                               HorizontalAlignment="Left"
                               Click="LoginButton_Click"/>
                    <TextBlock x:Name="LoginStatusText" Text="" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="2,7,0,0"/>

                    <TextBlock Text="FOLDER ID" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,16,0,6"/>
                    <ui:TextBox x:Name="FolderBox" PlaceholderText="Optional - destination folder id"
                                TextChanged="FolderBox_TextChanged"/>
                </StackPanel>
            </ui:CardExpander>

            <!-- Upload button -->
            <ui:Button x:Name="UploadButton" Content="Upload" Appearance="Primary"
                       Icon="{ui:SymbolIcon CloudArrowUp24}"
                       Foreground="White"
                       Style="{StaticResource PrimaryMotionButtonStyle}"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                       FontSize="13.5" FontWeight="SemiBold" Height="36" Margin="0,14,0,0"
                       Click="UploadButton_Click"/>

            <!-- Progress - hidden until an upload actually starts, so the idle window stays compact -->
            <StackPanel x:Name="ProgressSection" Visibility="Collapsed" Margin="0,14,0,0" Opacity="0">
                <ProgressBar x:Name="UploadProgress" Style="{StaticResource SleekProgressBarStyle}"
                             Margin="0,0,0,6" Minimum="0" Maximum="100" Value="0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" Text=""
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
                    <TextBlock x:Name="PercentText" Grid.Column="1" Text=""
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>

            <!-- Result - revealed only once there's an actual link to show -->
            <Border x:Name="ResultCard" Visibility="Collapsed" Opacity="0"
                    Background="{StaticResource GlassCardBackgroundBrush}"
                    BorderBrush="{StaticResource GlassCardBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="DOWNLOAD LINK" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="ResultBox" Grid.Column="0" IsReadOnly="True"
                                    PlaceholderText="Your link will appear here"/>
                        <ui:Button x:Name="CopyButton" Grid.Column="1" Margin="8,0,0,0"
                                   Icon="{ui:SymbolIcon Copy24}" IsEnabled="False"
                                   Style="{StaticResource MotionButtonStyle}"
                                   Click="CopyButton_Click"/>
                        <ui:Button x:Name="OpenButton" Grid.Column="2" Margin="8,0,0,0"
                                   Icon="{ui:SymbolIcon Open24}" IsEnabled="False"
                                   Style="{StaticResource MotionButtonStyle}"
                                   Click="OpenButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</ui:FluentWindow>
